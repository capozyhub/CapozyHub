# ========================================================================
# KiNG FLEXY GH — Environment Variables Template
#
# Copy this file to `.env.local` and fill in real values. Never commit the
# real .env.local — it is already gitignored.
#
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser. All others
# are server-side only. Keep secrets out of the NEXT_PUBLIC_ namespace.
# ========================================================================

# ── Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Paystack (payment gateway) ──────────────────────────────────────────
PAYSTACK_SECRET_KEY=your_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# ── CodeCraft API (AT-iShare, Telecel, AT-BigTime) ──────────────────────
CODECRAFT_API_URL=https://api.codecraftnetwork.com/api
CODECRAFT_API_KEY=your_codecraft_api_key

# ── DataKazina API ──────────────────────────────────────────────────────
DATAKAZINA_API_KEY=your_datakazina_api_key
# Webhook auth for /api/webhooks/dakazina. DataKazina does NOT issue a webhook secret —
# generate this value yourself (e.g. `openssl rand -hex 32`) and embed it in the URL you
# register in their dashboard, because their webhook config is URL-only (no custom-header
# or signing-secret field):
#   https://<your-domain>/api/webhooks/dakazina?secret=<this value>
# The route also accepts HTTP Basic userinfo (https://x:<secret>@host/... — preferred, keeps
# it out of access logs) or an x-dakazina-secret header.
# REQUIRED: the route fails CLOSED with 503 and rejects every delivery while this is unset.
DAKAZINA_WEBHOOK_SECRET=your_generated_dakazina_webhook_secret_here
DATAKAZINA_API_BASE_URL=https://reseller.dakazinabusinessconsult.com/api/v1

# ── Xpress API (MTN, Telecel, AirtelTigo) ───────────────────────────────
XPRESS_KEY=your_xpress_api_key_here
# Webhook secret — add as ?secret=VALUE to the URL you register in the Xpress
# dashboard. Or send as X-Webhook-Secret header. Leave blank to disable
# verification (dev only).
XPRESS_WEBHOOK_SECRET=your_xpress_webhook_secret_here

# ── GhData API (4th data bundle supplier — MTN, Telecel, AirtelTigo) ────
GHDATA_API_KEY=your_ghdata_api_key_here
# Optional — defaults to https://www.ghdata.xyz/api/agent/v1 if unset
GHDATA_API_BASE_URL=https://eazyghdata.com/api/agent/v1
# whsec_... shown by GhData's Agent Portal (API Configuration → Webhooks) after registering
# https://www.kingflexygh.com/api/webhooks/ghdata as the destination URL. Required — the
# webhook route fails closed (503) if unset.
GHDATA_WEBHOOK_SECRET=whsec_your_ghdata_webhook_secret_here

# ── AgentPortal API (5th data bundle supplier — MTN, Telecel, AirtelTigo) ───
AGENTPORTAL_API_KEY=your_agentportal_api_key_here
AGENTPORTAL_API_BASE_URL=https://api.agentportalgh.com
# sha256=<hex> HMAC secret. Unlike the other suppliers, this one requires calling
# PUT https://api.agentportalgh.com/api/webhooks/config yourself once (curl/Postman) with
# your AGENTPORTAL_API_KEY to register this app's webhook URL and receive the secret back.
AGENTPORTAL_WEBHOOK_SECRET=your_agentportal_webhook_secret_here

# ── Bundle Portal (6th data bundle supplier — MTN/Telecel/AT-iShare) ────
# docs/reference/bundleportal-developer-api.md
BUNDLEPORTAL_API_KEY=your_bundleportal_api_key
# Optional — defaults to https://api.bundleportal.com/v1 if unset
BUNDLEPORTAL_API_BASE_URL=https://api.bundleportal.com/v1

# ── HendyLinks (7th data bundle supplier — MTN/Telecel/AirtelTigo) ──────
# docs/superpowers/specs/2026-08-19-hendylinks-supplier-design.md
HENDYLINKS_API_KEY=your_hendylinks_api_key
# Optional — defaults to https://hendylinks.net if unset
HENDYLINKS_API_BASE_URL=https://hendylinks.net
# sha256=<hex> HMAC secret for the order.status_changed webhook. HendyLinks signs with your
# API token today, so leave this line COMMENTED OUT / unset to fall back to HENDYLINKS_API_KEY
# — uncomment and set it only if HendyLinks ever issues a distinct webhook secret. Any non-empty
# value here (even a copy-pasted placeholder) is used AS THE SECRET, not as "unset", so it will
# silently fail every real webhook's signature check if left as a placeholder string. The
# webhook route fails closed (503) if BOTH this and HENDYLINKS_API_KEY are unset.
# HENDYLINKS_WEBHOOK_SECRET=your_hendylinks_webhook_secret_here

# ── AT-iShare Console (SPFastIT) — supplier #8, AT-iShare network only. ─
# Docs: docs/reference/atishare-console-spfastit-api.md
# NOTE: this key travels in the POST body — never log request bodies for this service.
ATISHARE_CONSOLE_API_KEY=
ATISHARE_CONSOLE_BASE_URL=https://console.spfastit.com/api

# ── SPFastIT Supplier API (full wallet account, NOT the Console above) ───────────
# Telecel-only supplier, wired into fulfillment dispatch (ships disabled by default —
# enable via the admin fulfillment settings page). Same vendor as the Console above,
# but a separate product: different domain, JSON body (not form-encoded).
# Docs: docs/reference/spfastit-supplier-api.md
# NOTE: this key travels in the POST body — never log request bodies for this service.
SPFASTIT_API_KEY=
SPFASTIT_BASE_URL=https://spfastit.com/wp-json/custom-api/v1
SPFASTIT_WEBHOOK_SECRET=

# ── DataGod (Results Checker supplier) ──────────────────────────────────
DATAGOD_API_KEY=your_datagod_api_key

# ── Auto-Fulfillment Toggle ─────────────────────────────────────────────
# Set to 'false' to disable auto-fulfillment. When disabled, orders stay
# as 'pending' for manual processing in the admin panel.
ENABLE_AUTO_FULFILLMENT=true

# ── Moolre (SMS sender + bank transfer API) ─────────────────────────────
MOOLRE_API_KEY=your_moolre_api_key
MOOLRE_SENDER_ID=GHData
SMS_ENABLED=true

# Moolre Transfer API (separate from SMS) — used for automated shop
# withdrawals. Get these from https://app.moolre.com.
MOOLRE_TRANSFER_API_USER=your_moolre_username
MOOLRE_TRANSFER_API_KEY=your_moolre_transfer_api_key
MOOLRE_ACCOUNT_NUMBER=your_moolre_account_number

# ── mNotify (fallback SMS provider) ─────────────────────────────────────
MNOTIFY_API_KEY=your_mnotify_api_key
MNOTIFY_SENDER_ID=KingFlexy

# ── Hubtel SMS (PRIMARY SMS provider — platform + user SMS platform) ─────
# Separate credential pair from HUBTEL_API_ID/HUBTEL_API_KEY (USSD/Commission).
HUBTEL_CLIENT_ID=your_hubtel_sms_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_sms_client_secret
# Platform sender ID (11 chars max) — used for all KiNG FLEXY messages.
HUBTEL_SENDER_ID=KINGFLEXY
# Shared secret for the Hubtel SMS delivery-report webhook
# (/api/webhooks/hubtel-sms-dlr) — passed by Hubtel in the x-dlr-secret
# HEADER (never a query param). Webhook 503s until this is set.
HUBTEL_SMS_DLR_SECRET=your_dlr_secret
# Optional override for the Hubtel message-status endpoint (reconcile cron).
# Defaults to the documented https://sms.hubtel.com/v1/messages/{id} — only
# set this to override. Reconcile runs on the SMS creds above.
HUBTEL_SMS_STATUS_URL=

# ── Email Providers (any one of these can be configured) ────────────────
# Brevo (formerly Sendinblue) — transactional email
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@your_domain.com
BREVO_SENDER_NAME=KiNG FLEXY GH

# Resend — alternative transactional email
RESEND_API_KEY=your_resend_api_key

# MailerSend — alternative transactional email
MAILERSEND_API_KEY=your_mailersend_api_key

# ── Web Push Notifications (VAPID keys) ─────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@your_domain.com

# ── Feature Flags ───────────────────────────────────────────────────────
NEXT_PUBLIC_PAYMENT_MAINTENANCE_MODE=false

# ── App URLs ────────────────────────────────────────────────────────────
# Canonical site URL for auth callbacks (password reset, email actions)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cross-subdomain auth cookie domain. Set to `.kingflexygh.com` in PRODUCTION
# ONLY so one session is shared across apex + shop + store. MUST stay
# UNSET on localhost/preview — a domain-scoped cookie breaks localhost sign-in.
# NEXT_PUBLIC_COOKIE_DOMAIN=.kingflexygh.com

# ── Google OAuth ────────────────────────────────────────────────────────
# Get from Google Cloud Console → APIs & Services → Credentials.
# Add your domain + /auth/callback as an authorised redirect URI.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ── Cron Authentication ─────────────────────────────────────────────────
# Shared secret used to authenticate Vercel Cron requests.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_cron_secret

# ── Upstash Redis (rate limiting) ───────────────────────────────────────
# Recommended: Use Vercel KV (Vercel dashboard → Storage → KV).
# Vercel Pro includes 500k commands/month free — 50x more than Upstash free tier.
# After adding Vercel KV, Vercel sets KV_REST_API_URL and KV_REST_API_TOKEN
# automatically. Rename them to UPSTASH_REDIS_REST_URL/TOKEN here and in
# Vercel env vars — the @upstash/redis client reads these same names.
# If both are missing, rate limiting is silently skipped (site still works).
UPSTASH_REDIS_REST_URL="your-upstash-redis-rest-url-here"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token-here"

# ── Developer API ───────────────────────────────────────────────────────
# Server-side salt for hashing API keys into rate-limit buckets.
# Required for the v1 rate limiter to prevent prefix-spoofing DoS.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_RATE_LIMIT_SALT=replace_with_64_hex_chars_from_crypto_randomBytes_32

# ── MoMo SMS Forwarding Webhook ─────────────────────────────────────────
# Shared secret for the SMS-forwarder webhook that auto-credits wallets
# from incoming MoMo deposit SMS messages.
SMS_FORWARD_SECRET=your_secret_here

# ── Hubtel USSD ──────────────────────────────────────────────────────────
# Get all values from Hubtel Merchant Dashboard → Programmable Services
HUBTEL_API_ID=your_hubtel_api_id
HUBTEL_API_KEY=your_hubtel_api_key
HUBTEL_COLLECTION_ACCOUNT=your_hubtel_collection_account
USSD_SERVICE_CODE=9939
# Full USSD shortcode shown on banners and UI. NEXT_PUBLIC_ exposes it to the browser.
NEXT_PUBLIC_USSD_SHORTCODE=*713*9939#
# HMAC secret for signing USSD ClientState blobs (prevents shopId/price forgery).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production — without it, ClientState is unsigned (dev-only fallback).
USSD_STATE_SECRET=replace_with_64_hex_chars_from_crypto_randomBytes_32

# ── Hubtel Commission Services — airtime auto-fulfillment ──
HUBTEL_COMMISSION_WEBHOOK_SECRET=
HUBTEL_DISBURSEMENT_ACCOUNT=
# HUBTEL_AIRTIME_SERVICEID_MTN=
# HUBTEL_AIRTIME_SERVICEID_TELECEL=
# HUBTEL_AIRTIME_SERVICEID_AT=

# Hubtel Commission Status Check (reuses HUBTEL_COLLECTION_ACCOUNT + Basic auth; Fixie IP must be Hubtel-whitelisted)
HUBTEL_COMMISSION_STATUSCHECK_AUTO=false
